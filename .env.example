# Forwarding Address needs NO secrets to run.
# Every endpoint on the judged path — the CLI, the MCP server, the hosted proxy — is
# CoinMarketCap's keyless /public-api surface. Nothing below is required.

# ── CoinMarketCap (optional escape hatch) ─────────────────────────────────────────────────────
# Only if the anonymous tier has throttled your IP and you cannot wait a minute — never for the
# demo. Any of the three names is read; a set key moves the identical calls to the keyed host
# and the run announces itself as keyed on its first line, its last line and in its receipt.
# Get from: https://coinmarketcap.com/api → "Get your API key now" (free Basic plan)
# CMC_API_KEY=
# COINMARKETCAP_API_KEY=
# CMC_PRO_API_KEY=

# ── Tuning (optional) ─────────────────────────────────────────────────────────────────────────
# Seconds between calls on the anonymous tier. The CLI default is 2.0; the Vercel proxy sets 0.4
# in code because one visitor is six calls. Lower it and the tier throttles sooner.
# FORWARDING_SPACING=2.0
