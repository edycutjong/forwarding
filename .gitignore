# secrets — credentials live in ~/.config/, never in this tree
.env
.env.*
!.env.example
*.key
credentials.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# node / vercel
node_modules/
.vercel/
.next/
dist/

# os / editor
.DS_Store
*.swp
.idea/
.vscode/

# kitchen guard — specs/, submission/ and assets/ live one level up and must never
# enter this repo. /publish copies selected artifacts into docs/, never into these.
/assets/*
!/assets/fonts-src/
/specs/
/submission/
_ideas/
_specs/
graphify-out/

# scratch output from local runs (the committed receipts live in docs/proof/)
/out/
*.local.json

# scanner reports (gitleaks --report-path, pip-audit --output) — never commit a finding
gitleaks-report.*
pip-audit.*

# docs/assets — only the images a page actually displays are tracked (whitelisted with !).
# Anything else dropped here (Devpost gallery, YouTube thumbnail, dev.to cover, icon
# PNG exports) is a submission-form upload, not repo content.
/docs/assets/*
!/docs/assets/icon.svg
!/docs/assets/icon-animated.svg
!/docs/assets/og-image.png
!/docs/assets/readme-hero-animated.svg
